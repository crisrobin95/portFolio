# Creación del archivo temporal para registrar la salida
TEMP_FILE=$(mktemp)

# Ejecutamos vitest y typecheck usando 'pnpm exec' para asegurar que encuentre los binarios locales
pnpm exec vitest run && \
pnpm exec nuxi typecheck 2>&1 | tee "$TEMP_FILE"

# Buscar errores en el archivo temporal
if grep -q "error" "$TEMP_FILE"; then
    printf "\n\e[31m"
    printf "
███████ ██████  ██████   ██████  ██████  
██      ██   ██ ██   ██ ██    ██ ██   ██ 
█████   ██████  ██████  ██    ██ ██████  
██      ██   ██ ██   ██ ██    ██ ██   ██ 
███████ ██   ██ ██   ██  ██████  ██   ██ 
                                         
\n"
    printf "Please execute the next command to see the errors in more detail: 'pnpm exec nuxi typecheck'\n\n"
   
    printf "❌ Typecheck failed! Commit aborted. ❌\n\n"
    printf "\e[0m"
    rm "$TEMP_FILE"
    exit 1
fi

# Limpiar el archivo temporal
rm "$TEMP_FILE"

# Ejecutamos lint-staged de forma segura
pnpm exec lint-staged